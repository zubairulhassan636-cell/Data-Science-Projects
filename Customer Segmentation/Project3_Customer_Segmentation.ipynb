   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Elbow method suggests K = 6\n",
      "Best K by Silhouette Score = 9\n"
     ]
    }
   ],
   "source": [
    "wcss = []\n",
    "sil_scores = []\n",
    "K_range = range(2, 11)\n",
    "\n",
    "for k in K_range:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    labels = km.fit_predict(X_pca)\n",
    "    wcss.append(km.inertia_)\n",
    "    sil_scores.append(silhouette_score(X_pca, labels))\n",
    "\n",
    "# Elbow heuristic: choose the K with maximum distance from the\n",
    "# straight line joining the first and last WCSS points.\n",
    "ks = np.array(list(K_range))\n",
    "wcss_arr = np.array(wcss)\n",
    "x_norm = (ks - ks.min()) / (ks.max() - ks.min())\n",
    "y_norm = (wcss_arr - wcss_arr.min()) / (wcss_arr.max() - wcss_arr.min())\n",
    "line_y = 1 - x_norm\n",
    "distances = np.abs(y_norm - line_y) / np.sqrt(2)\n",
    "elbow_k = int(ks[np.argmax(distances)])\n",
    "\n",
    "print(\"Elbow method suggests K =\", elbow_k)\n",
    "print(\"Best K by Silhouette Score =\", list(K_range)[np.argmax(sil_scores)])\n"
   ]
  },
