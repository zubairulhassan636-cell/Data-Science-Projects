   "source": [
    "def assign_persona(row):\n",
    "    \"\"\"Assign a business persona using income and spending behavior.\"\"\"\n",
    "    high_income = row['Annual_Income'] >= persona_summary['Annual_Income'].median()\n",
    "    high_spend = row['Spending_Score'] >= persona_summary['Spending_Score'].median()\n",
    "\n",
    "    if high_income and high_spend:\n",
    "        return \"High-Value Trendsetters\", \"Exclusive perks, early access, experiential marketing.\"\n",
    "    elif high_income and not high_spend:\n",
    "        return \"Affluent Conservatives\", \"High-touch support, warranties, loyalty programs.\"\n",
    "    elif not high_income and high_spend:\n",
    "        return \"Budget-Conscious Explorers\", \"Influencer campaigns, flash sales, buy-now-pay-later.\"\n",
    "    else:\n",
    "        return \"Conservative Minimizers\", \"Minimize spend, clear price-value, basic utility.\"\n",
    "\n",
    "persona_names, actions = [], []\n",
    "for _, row in persona_summary.iterrows():\n",
    "    name, action = assign_persona(row)\n",
    "    persona_names.append(name)\n",
    "    actions.append(action)\n",
    "\n",
    "persona_summary['Persona'] = persona_names\n",
    "persona_summary['Recommended_Action'] = actions\n",
    "persona_summary\n"
   ]
  },
