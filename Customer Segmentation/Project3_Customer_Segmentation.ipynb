   "source": [
    "import os\n",
    "\n",
    "if os.path.exists('retail_customers.csv'):\n",
    "    df = pd.read_csv('retail_customers.csv')\n",
    "else:\n",
    "    # Self-contained fallback dataset so the notebook can run without an external CSV.\n",
    "    n = 500\n",
    "    rng = np.random.default_rng(42)\n",
    "    df = pd.DataFrame({\n",
    "        'CustomerID': np.arange(1, n + 1),\n",
    "        'Age': rng.integers(18, 70, n),\n",
    "        'Annual_Income': np.clip(rng.normal(55, 22, n), 15, 140).round(1),\n",
    "        'Spending_Score': np.clip(rng.normal(55, 23, n), 1, 100).round(1),\n",
    "        'Purchase_Frequency_Monthly': np.clip(rng.normal(6, 2.5, n), 1, 15).round(1),\n",
    "        'Online_Purchase_Ratio': np.clip(rng.beta(2.2, 2.0, n), 0, 1).round(3),\n",
    "        'Loyalty_Points': np.clip(rng.normal(2500, 1200, n), 100, 7000).round().astype(int),\n",
    "        'Gender': rng.choice(['Female', 'Male'], n, p=[0.52, 0.48])\n",
    "    })\n",
    "    # Add a few realistic correlations to make segmentation meaningful.\n",
    "    df['Spending_Score'] = np.clip(\n",
    "        0.45 * df['Spending_Score'] + 0.35 * df['Annual_Income'] / 140 * 100 +\n",
    "        0.20 * df['Purchase_Frequency_Monthly'] / 15 * 100, 1, 100\n",
    "    ).round(1)\n",
    "    df.to_csv('retail_customers.csv', index=False)\n",
    "    print(\"retail_customers.csv was not found; a reproducible demo dataset was generated.\")\n",
    "\n",
    "print(\"Shape:\", df.shape)\n",
    "df.head()\n"
   ]
  },
